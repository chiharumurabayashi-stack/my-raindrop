{
  "manifest_version": 3,
  "name": "MyRaindrop",
  "version": "1.3",
  "description": "現在のページをMyRaindropに保存",
  "permissions": [
    "activeTab",
    "tabs",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "https://firestore.googleapis.com/*",
    "https://generativelanguage.googleapis.com/*",
    "https://identitytoolkit.googleapis.com/*",
    "https://securetoken.googleapis.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "MyRaindropに保存"
  },
  "background": {
    "service_worker": "background.js"
  },
  "externally_connectable": {
    "matches": [
      "https://chiharumurabayashi-stack.github.io/my-raindrop/*"
    ]
  }
}
